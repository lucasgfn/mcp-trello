# API Key do Power-Up: https://trello.com/power-ups/admin
TRELLO_API_KEY=
# Token do usuário (veja o README para gerar)
TRELLO_TOKEN=
# Organizações permitidas: IDs ou nomes curtos (`name`), separados por vírgula
TRELLO_ORG_ALLOWLIST=minha-org

# Desabilita todas as tools de escrita
TRELLO_READ_ONLY=false
# Habilita tools destrutivas (remover membro, fechar board); exigem confirm=true
TRELLO_ALLOW_DESTRUCTIVE=false
# Requisições por janela de 10 s (limite do Trello por token: 100)
TRELLO_RATE_LIMIT=100

# stdio (local) ou http (Streamable HTTP em http://HOST:PORT/mcp)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333

# Arquivo JSONL de auditoria das escritas (opcional)
AUDIT_LOG_PATH=
